# Copy to .env.local (never commit the real file). On Vercel, add these under Project → Settings → Environment Variables.

# Model — free: create a key at https://console.groq.com
GROQ_API_KEY=

# Web search for Partner Scout — free tier: https://tavily.com
TAVILY_API_KEY=

# Google sign-in (protects the live AI routes once deployed). Create an OAuth client ID
# (type: Web application) at https://console.cloud.google.com/apis/credentials and add your
# site to "Authorized JavaScript origins" (http://localhost:5173 and https://<your-app>.vercel.app).
GOOGLE_CLIENT_ID=
# Random 32+ character string that signs session cookies, e.g. `openssl rand -base64 48`.
SESSION_SECRET=
# Optional: only these accounts may sign in, e.g. "you@gmail.com,@thapar.edu"
# ALLOWED_EMAILS=

# Optional alternatives (the first one with a key is used unless LLM_PROVIDER is set):
# LLM_PROVIDER=groq            # groq | huggingface | openrouter | ollama | anthropic
# LLM_MODEL=openai/gpt-oss-120b   # Groq default; falls back to openai/gpt-oss-20b automatically
# HF_TOKEN=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# For a fully offline fallback: install Ollama, run `ollama pull qwen2.5:7b`, set LLM_PROVIDER=ollama
